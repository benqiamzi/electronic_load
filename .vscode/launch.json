{
    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "PySide6: 运行电子负载上位机",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}\\host_app\\.venv\\Scripts\\python.exe",
            "program": "${workspaceFolder}\\host_app\\run.py",
            "cwd": "${workspaceFolder}\\host_app",
            "console": "integratedTerminal",
            "justMyCode": true,
            "preLaunchTask": "PySide6: 准备运行环境",
            "env": {
                "PYTHONUTF8": "1"
            }
        },
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: Launch ST-Link GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}\\firmware",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"
                }
            ]
        }
    ]
}
